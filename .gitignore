# Python bytecode
__pycache__/
*.py[cod]

# Audio MP3 binaries live on the dedicated 1-commit `ai-companion-audio` orphan branch
# (local MP3 cache stays on disk for incremental `refresh_voices.py` runs,
# while `audio/<persona>/tts_manifest.json` stays tracked on `ai-companion`).
audio/*.mp3
audio/**/*.mp3
!audio/kalyani/tts_manifest.json
!audio/anondo/tts_manifest.json
!audio/jhalak/tts_manifest.json
!audio/books/**/manifest.json
