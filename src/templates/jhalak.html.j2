<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#18120E" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="description" content="ঝলক (Jhalak) — মায়ের জন্য ভগবানের অমৃতকথা, হাসির গল্প, মনের শান্তি, কৌতূহল, চিরদিনের গান ও অর্থ, সহজ ইংরেজি শব্দ, হিন্দি কথোপকথন এবং টিভি।" />
  <title>✨ ঝলক</title>
  <link id="pageFavicon" data-emoji="✨" data-png-b64="{{ favicon_uri }}" data-https-png="https://raw.githubusercontent.com/kouSeek/portfolio/kalyani-reels/assets/icons/favicon-jhalak.png?v=1" data-https-ico="https://raw.githubusercontent.com/kouSeek/portfolio/kalyani-reels/assets/icons/favicon-jhalak.ico?v=1" rel="icon" type="image/png" sizes="64x64" href="https://raw.githubusercontent.com/kouSeek/portfolio/kalyani-reels/assets/icons/favicon-jhalak.png?v=1" />
  <link rel="shortcut icon" type="image/x-icon" href="https://raw.githubusercontent.com/kouSeek/portfolio/kalyani-reels/assets/icons/favicon-jhalak.ico?v=1" />
  <link rel="apple-touch-icon" sizes="64x64" href="{{ favicon_uri }}" />
  <link rel="manifest" href="jhalak-manifest.json" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@700;800&display=swap" rel="stylesheet" />
  <style>
{{ css_bundle | safe }}
  </style>
</head>
<body>

  <!-- TOP BAR: BRAND + CATEGORY DROPDOWN + LISTEN BUTTON + SETTINGS GEAR -->
  <header class="jh-topbar" role="banner">
    <div class="jh-topbar-row1">
      <div class="jh-brand-cluster">
        <span class="jh-brand-logo" aria-label="ঝলক">✨</span>

        <!-- CATEGORY SELECTION DROPDOWN -->
        <div id="jhCategoryDropdownWrap" class="jh-cat-dropdown-wrap">
          <button id="btnJhCategoryDropdown" type="button" class="jh-cat-dropdown-btn" onclick="toggleJhCategoryDropdown(event)" aria-haspopup="listbox">
            ✨ সব ▾
          </button>
          <div id="jhCategoryDropdownMenu" class="jh-cat-dropdown-menu" role="listbox" aria-label="বিভাগ নির্বাচন"></div>
        </div>
      </div>

      <div class="jh-topbar-actions">
        <button id="btnJhHeaderListen" type="button" class="jh-top-listen-btn" onclick="playReelAudioAtIndex()" aria-label="শোনো">
          🔊 শোনো
        </button>
        <button id="btnJhHeaderStop" type="button" class="jh-top-stop-btn" onclick="stopJhAudio()" aria-label="বন্ধ করো" title="বন্ধ করো" style="display:none;">
          ⏹️ বন্ধ
        </button>
        <button id="btnJhSettings" type="button" class="jh-gear-btn" onclick="openJhalakSettingsDrawer()" aria-label="সেটিংস" title="সেটিংস">
          ⚙️
        </button>
      </div>
    </div>
  </header>

  <!-- ELASTIC PULL-TO-TURN INDICATORS (TOP = PREVIOUS PAGE, BOTTOM = NEXT PAGE) -->
  <div id="jhPullIndicatorTop" class="jh-pull-indicator jh-pull-indicator-top" aria-live="polite">
    <div class="jh-pull-row">
      <span id="jhPullTopArrow" class="jh-pull-arrow">⬇️</span>
      <span id="jhPullTopText">আগের পাতায় যেতে আরও একটু টানো...</span>
    </div>
    <div class="jh-pull-progress-track">
      <div id="jhPullTopFill" class="jh-pull-progress-fill"></div>
    </div>
  </div>

  <!-- FULL-SCREEN LONG-CONTENT PAGE VIEWPORT (ELASTIC OVERSCROLL PULL FOR PREV/NEXT) -->
  <main id="jhReelsViewport" class="jh-reels-viewport" aria-label="ঝলক পাতা"></main>

  <div id="jhPullIndicatorBottom" class="jh-pull-indicator jh-pull-indicator-bottom" aria-live="polite">
    <div class="jh-pull-row">
      <span id="jhPullBottomArrow" class="jh-pull-arrow">⬆️</span>
      <span id="jhPullBottomText">পরের পাতায় যেতে আরও একটু টানো...</span>
    </div>
    <div class="jh-pull-progress-track">
      <div id="jhPullBottomFill" class="jh-pull-progress-fill"></div>
    </div>
  </div>

  <!-- SETTINGS & ADMIN DRAWER: AUTO-REELS, AUTO-VOICE, SINGLE/MULTI CATEGORY, LIKE COUNT TOGGLE, CHITHI, STATS & ADMIN DONE/LIKE EDITOR -->
  <div id="jhSettingsDrawer" class="jh-drawer-backdrop" role="dialog" aria-modal="true" aria-labelledby="jhSettingsDrawerTitle">
    <div class="jh-drawer-sheet">
      <div class="jh-drawer-head">
        <h2 id="jhSettingsDrawerTitle" class="jh-drawer-title">⚙️ সেটিংস ও অ্যাডমিন কন্ট্রোল</h2>
        <button id="btnCloseSettingsDrawer" type="button" class="jh-drawer-close" onclick="closeJhalakSettingsDrawer()">✕ বন্ধ করো</button>
      </div>

      <div class="jh-settings-list">
        <button id="btnJhAutoFlow" type="button" class="jh-settings-item-btn active-flow" onclick="toggleJhAutoFlow()">
          🔄 অটো-রিলস (পরের পাতা): চালু
        </button>
        <button id="btnJhAutoVoice" type="button" class="jh-settings-item-btn active-flow" onclick="toggleJhAutoVoice()">
          🔊 অটো-ভয়েস: চালু
        </button>
        <button id="btnJhCatSelectMode" type="button" class="jh-settings-item-btn" onclick="toggleJhCategorySelectMode()">
          📂 বিভাগ নির্বাচন: একটাই (Single-Select)
        </button>
        <button id="btnJhShowLikeCount" type="button" class="jh-settings-item-btn active-flow" onclick="toggleJhShowLikeCount()">
          ❤️ লাইকের সংখ্যা দেখাও: চালু
        </button>
        <button id="btnJhOpenChithi" type="button" class="jh-settings-item-btn" onclick="openJhalakLetterDrawer()">
          <span>💌 চিঠি (কৌশিকের খোলা চিঠি ও ভিডিও)</span>
          <span>➡️</span>
        </button>
      </div>

      <div>
        <h3 class="jh-stats-section-title">📊 প্রতিটি বিভাগের পাতার সংখ্যা ও লাইক পরিসংখ্যান</h3>
        <div id="jhCategoryStatsBox" class="jh-stats-grid"></div>
      </div>

      <div id="jhAdminControlSection">
        <h3 class="jh-stats-section-title">🛠️ অ্যাডমিন কন্ট্রোল: ডান (Done) ও লাইক (Likes) পরিবর্তন করো</h3>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;">
          <button id="btnAdminResetDone" type="button" class="jh-letter-step-btn" onclick="resetAllJhDoneCounts()">🔄 সব ডান (Done) রিসেট করো</button>
          <button id="btnAdminResetLikes" type="button" class="jh-letter-step-btn" onclick="resetAllJhLikeCounts()">🔄 সব লাইক (Likes) রিসেট করো</button>
        </div>
        <div id="jhAdminItemsList" class="jh-admin-items-list"></div>
      </div>
    </div>
  </div>

  <!-- CHITHI DRAWER: KOUSHIK'S 8-SLIDE LETTER + FULL HD MOVIE -->
  <div id="jhLetterDrawer" class="jh-drawer-backdrop" role="dialog" aria-modal="true" aria-labelledby="jhLetterDrawerTitle">
    <div class="jh-drawer-sheet">
      <div class="jh-drawer-head">
        <h2 id="jhLetterDrawerTitle" class="jh-drawer-title">💌 মায়ের জন্য কৌশিকের খোলা চিঠি</h2>
        <button id="btnCloseLetterDrawer" type="button" class="jh-drawer-close" onclick="closeJhalakLetterDrawer()">✕ বন্ধ করো</button>
      </div>
      <div>
        <img id="jhLetterImg" class="jh-slide-img" src="" alt="মা ও পরিবারের ছবি" />
        <h3 id="jhLetterTitle" style="font-family:'Noto Serif Bengali',serif;font-size:1.15rem;margin-bottom:6px;"></h3>
        <p id="jhLetterBody" style="font-size:0.98rem;line-height:1.6;margin-bottom:12px;"></p>
        <div class="jh-letter-controls">
          <button id="btnJhLetterPrev" type="button" class="jh-letter-step-btn" onclick="stepJhalakLetterSlide(-1)">⬅️ আগের পাতা</button>
          <button id="btnJhLetterPlay" type="button" class="jh-top-listen-btn" onclick="playJhalakLetterAudio()">🔊 শোনো</button>
          <button id="btnJhLetterStop" type="button" class="jh-top-stop-btn" onclick="stopJhAudio()" style="display:none;">⏹️ বন্ধ</button>
          <button id="btnJhLetterNext" type="button" class="jh-letter-step-btn" onclick="stepJhalakLetterSlide(1)">পরের পাতা ➡️</button>
        </div>
        <a id="btnJhWatchMovie" class="jh-yt-link" href="{{ letter_video_url }}" target="_blank" rel="noopener noreferrer">
          🎬 পুরো ভিডিও চিঠিটি দেখো ▶️
        </a>
      </div>
    </div>
  </div>

  <audio id="jhAudioPlayer" preload="auto"></audio>

  <script>
{{ data_js | safe }}
{{ js_bundle | safe }}
  </script>
</body>
</html>
