<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#18120E" />
  <meta name="description" content="ঝলক (Jhalak) — মায়ের জন্য স্বতঃস্ফূর্ত আনন্দের রিলস, হাসির গল্প, ভগবানের লীলা, মনের আরাম, কৌতূহল ও গান।" />
  <title>✨ ঝলক</title>
  <link id="pageFavicon" data-emoji="✨" data-png-b64="{{ favicon_uri }}" data-https-png="https://raw.githubusercontent.com/kouSeek/portfolio/ai-companion/assets/icons/favicon-kalyani.png?v=4" data-https-ico="https://raw.githubusercontent.com/kouSeek/portfolio/ai-companion/assets/icons/favicon-kalyani.ico?v=4" rel="icon" type="image/png" sizes="64x64" href="{{ favicon_uri }}" />
  <link rel="apple-touch-icon" sizes="64x64" href="{{ favicon_uri }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@700;800&display=swap" rel="stylesheet" />
  <style>
{{ css_bundle | safe }}
  </style>
</head>
<body>

  <!-- TOP FLOATING BAR: JHALAK + TV TABS, SETTINGS GEAR, AND MULTI-SELECT CATEGORIES -->
  <header class="jh-topbar" role="banner">
    <div class="jh-topbar-row1">
      <div class="jh-header-tabs" role="tablist">
        <button id="tabJhReels" class="jh-header-tab active" onclick="switchJhalakMainTab('reels')">
          ✨ ঝলক
        </button>
        <button id="tabJhTv" class="jh-header-tab" onclick="switchJhalakMainTab('tv')">
          📺 টিভি
        </button>
      </div>
      <button id="btnJhSettings" class="jh-gear-btn" onclick="openJhalakSettingsDrawer()" aria-label="সেটিংস" title="সেটিংস">
        ⚙️
      </button>
    </div>

    <nav id="jhChannelStrip" class="jh-channel-strip" aria-label="বিভাগ">
      <button id="chanAll" class="jh-chan-chip active" data-chan="all" onclick="filterJhalakChannel('all')">
        ✨ সব
      </button>
      <button id="chanLaughGods" class="jh-chan-chip" data-chan="laugh_gods" onclick="filterJhalakChannel('laugh_gods')">
        😂 হাসি
      </button>
      <button id="chanCbtCalm" class="jh-chan-chip" data-chan="cbt_calm" onclick="filterJhalakChannel('cbt_calm')">
        🦋 শান্তি
      </button>
      <button id="chanCuriositySong" class="jh-chan-chip" data-chan="curiosity_song" onclick="filterJhalakChannel('curiosity_song')">
        🔍 কৌতূহল
      </button>
      <button id="chanMusic" class="jh-chan-chip" data-chan="music" onclick="filterJhalakChannel('music')">
        🎵 গান
      </button>
    </nav>
  </header>

  <!-- FULL-SCREEN VERTICAL SCROLL-SNAP REELS STREAM -->
  <main id="jhReelsViewport" class="jh-reels-viewport" aria-label="ঝলক রিলস স্ট্রিম"></main>

  <!-- TV TAB VIEWPORT -->
  <section id="jhTvViewport" class="jh-tv-viewport" aria-label="টিভি">
    <div class="jh-tv-container">
      <h2 style="font-family:'Noto Serif Bengali',serif;font-size:1.35rem;margin-bottom:6px;">📺 মায়ের প্রিয় টিভি ও গান</h2>
      <p style="font-size:0.95rem;color:#5C4938;margin-bottom:10px;">যেকোনো একটিতে ছুঁলেই ইউটিউবে সরাসরি চালু হয়ে যাবে:</p>
      <div class="jh-tv-grid">
        <a class="jh-tv-card" href="https://www.youtube.com/results?search_query=Gopal+Bhar+Bengali+full+episodes" target="_blank" rel="noopener noreferrer">😂 গোপাল ভাঁড়ের হাসির কার্টুন ↗</a>
        <a class="jh-tv-card" href="https://www.youtube.com/results?search_query=Hemanta+Mukherjee+Sandhya+Mukherjee+Best+Bengali+Songs" target="_blank" rel="noopener noreferrer">🎵 হেমন্ত ও সন্ধ্যা মুখোপাধ্যায়ের গান ↗</a>
        <a class="jh-tv-card" href="https://www.youtube.com/results?search_query=Uttam+Suchitra+Bengali+full+movies" target="_blank" rel="noopener noreferrer">🎬 উত্তম-সুচিত্রার সেরা বাংলা ছবি ↗</a>
        <a class="jh-tv-card" href="https://www.youtube.com/results?search_query=Maa+Sarada+Sri+Ramakrishna+Bengali+stories" target="_blank" rel="noopener noreferrer">🪷 মা সারদা ও ঠাকুরের অমৃতকথা ↗</a>
        <a class="jh-tv-card" href="https://www.youtube.com/results?search_query=Manna+Dey+Rabindra+Sangeet+Bengali+hit+songs" target="_blank" rel="noopener noreferrer">🎼 মান্না দে ও রবীন্দ্রসঙ্গীতের আসর ↗</a>
        <a class="jh-tv-card" href="https://www.youtube.com/results?search_query=Satyajit+Ray+Feluda+Bengali+full+movie" target="_blank" rel="noopener noreferrer">🕵️‍♂️ সত্যজিৎ রায়ের ফেলুদা ও বাংলা ছবি ↗</a>
      </div>
    </div>
  </section>

  <!-- SETTINGS GEAR DRAWER: AUTO-REELS, AUTO-PLAY VOICES & CHITHI -->
  <div id="jhSettingsDrawer" class="jh-drawer-backdrop" role="dialog" aria-modal="true" aria-labelledby="jhSettingsDrawerTitle">
    <div class="jh-drawer-sheet">
      <div class="jh-drawer-head">
        <h2 id="jhSettingsDrawerTitle" class="jh-drawer-title">⚙️ সেটিংস</h2>
        <button id="btnCloseSettingsDrawer" class="jh-drawer-close" onclick="closeJhalakSettingsDrawer()">✕ বন্ধ করো</button>
      </div>
      <div class="jh-settings-list">
        <button id="btnJhAutoFlow" class="jh-settings-item-btn active-flow" onclick="toggleJhAutoFlow()">
          🔄 অটো-রিলস: চালু
        </button>
        <button id="btnJhAutoVoice" class="jh-settings-item-btn active-flow" onclick="toggleJhAutoVoice()">
          🔊 অটো-ভয়েস: চালু
        </button>
        <button id="btnJhOpenChithi" class="jh-settings-item-btn" onclick="openJhalakLetterDrawer()">
          <span>💌 চিঠি (কৌশিকের খোলা চিঠি ও ভিডিও)</span>
          <span>➡️</span>
        </button>
      </div>
    </div>
  </div>

  <!-- CHITHI DRAWER: KOUSHIK'S 8-SLIDE LETTER + FULL HD MOVIE -->
  <div id="jhLetterDrawer" class="jh-drawer-backdrop" role="dialog" aria-modal="true" aria-labelledby="jhLetterDrawerTitle">
    <div class="jh-drawer-sheet">
      <div class="jh-drawer-head">
        <h2 id="jhLetterDrawerTitle" class="jh-drawer-title">💌 মায়ের জন্য কৌশিকের খোলা চিঠি</h2>
        <button id="btnCloseLetterDrawer" class="jh-drawer-close" onclick="closeJhalakLetterDrawer()">✕ বন্ধ করো</button>
      </div>
      <div>
        <img id="jhLetterImg" class="jh-slide-img" src="" alt="মা ও পরিবারের ছবি" />
        <h3 id="jhLetterTitle" style="font-family:'Noto Serif Bengali',serif;font-size:1.15rem;margin-bottom:6px;"></h3>
        <p id="jhLetterBody" style="font-size:0.98rem;line-height:1.6;margin-bottom:12px;"></p>
        <div class="jh-letter-controls">
          <button id="btnJhLetterPrev" class="jh-letter-step-btn" onclick="stepJhalakLetterSlide(-1)">⬅️ আগের পাতা</button>
          <button id="btnJhLetterPlay" class="jh-top-listen-btn" onclick="playJhalakLetterAudio()">🔊 শোনো</button>
          <button id="btnJhLetterNext" class="jh-letter-step-btn" onclick="stepJhalakLetterSlide(1)">পরের পাতা ➡️</button>
        </div>
        <a id="btnJhWatchMovie" class="jh-yt-link" href="{{ letter_video_url }}" target="_blank" rel="noopener noreferrer">
          🎬 পুরো ভিডিও চিঠিটি দেখো ▶️
        </a>
      </div>
    </div>
  </div>

  <audio id="jhAudioPlayer" preload="auto"></audio>

  <script>
{{ data_js | safe }}
{{ js_bundle | safe }}
  </script>
</body>
</html>
