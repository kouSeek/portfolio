<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#0F172A" />
  <title>⚡ ANANDO — Koushik's Daily Clarity, Active Listening & Zorba Companion</title>
  <link rel="icon" type="image/svg+xml" href="favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&family=Noto+Sans+Bengali:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-main: #F8FAFC;
      --bg-card: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --ink-1: #0F172A;
      --ink-2: #334155;
      --ink-3: #64748B;
      --border: #E2E8F0;
      --brand: #0F766E;
      --brand-soft: #CCFBF1;
      --brand-active: #D8522E;
      --brand-active-soft: #FFF1EC;
      --amber: #B45309;
      --amber-soft: #FEF3C7;
      --rose: #BE123C;
      --rose-soft: #FFE4E6;
      --emerald: #047857;
      --emerald-soft: #D1FAE5;
      --indigo: #3730A3;
      --indigo-soft: #EEF2FF;
      --radius-lg: 18px;
      --radius-md: 12px;
      --shadow: 0 6px 24px rgba(15, 23, 42, 0.06);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', 'Noto Sans Bengali', sans-serif;
      background: var(--bg-main);
      color: var(--ink-1);
      line-height: 1.62;
      padding-bottom: 40px;
      -webkit-font-smoothing: antialiased;
    }

    .top-bar {
      position: sticky;
      top: 0;
      z-index: 120;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: 6px 12px;
    }
    .top-bar-inner {
      max-width: 720px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      flex-wrap: wrap;
    }
    .brand-wrap {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 800;
      font-size: 1.04rem;
      letter-spacing: -0.02em;
      color: var(--brand);
      cursor: pointer;
    }
    .nav-tabs {
      display: flex;
      align-items: center;
      gap: 5px;
      flex-wrap: wrap;
    }
    .tab-btn {
      border: 1.5px solid var(--border);
      background: var(--bg-subtle);
      color: var(--ink-2);
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1.45;
      transition: all 0.15s ease;
    }
    .tab-btn.active {
      background: var(--brand);
      color: #FFFFFF;
      border-color: var(--brand);
    }
    .hctrl-btn {
      border: 1.5px solid #F59E0B;
      background: #FEF3C7;
      color: #78350F;
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1.45;
      transition: all 0.15s ease;
    }
    .hctrl-btn.playing {
      background: var(--brand-active);
      color: #FFFFFF;
      border-color: var(--brand-active);
      box-shadow: 0 3px 10px rgba(216, 82, 46, 0.28);
    }
    .sos-btn {
      border: 1.5px solid #E11D48;
      background: #FFF1F2;
      color: #BE123C;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1.45;
    }

    .now-playing-bar {
      max-width: 720px;
      margin: 5px auto 2px;
      padding: 5px 10px;
      border-radius: 10px;
      background: var(--brand-active-soft);
      border: 1px solid rgba(216, 82, 46, 0.28);
      display: none;
      align-items: center;
      gap: 8px;
    }
    .now-playing-bar.visible { display: flex; }
    .eq-bars {
      display: inline-flex;
      align-items: flex-end;
      gap: 2px;
      height: 13px;
      color: var(--brand-active);
      flex-shrink: 0;
    }
    .eq-bars i {
      display: block;
      width: 2.5px;
      background: currentColor;
      border-radius: 2px;
      animation: eqBounce 0.75s ease-in-out infinite alternate;
    }
    .eq-bars i:nth-child(1) { height: 5px; animation-delay: 0s; }
    .eq-bars i:nth-child(2) { height: 12px; animation-delay: 0.18s; }
    .eq-bars i:nth-child(3) { height: 7px; animation-delay: 0.34s; }
    @keyframes eqBounce {
      0% { transform: scaleY(0.45); }
      100% { transform: scaleY(1); }
    }
    .np-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--brand-active);
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .np-track {
      flex: 1;
      height: 6px;
      background: rgba(216, 82, 46, 0.18);
      border-radius: 999px;
      overflow: hidden;
      cursor: pointer;
    }
    .np-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--brand-active), #F59E0B);
      border-radius: 999px;
      transition: width 0.15s linear;
    }
    .np-time {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--brand-active);
      white-space: nowrap;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 14px 12px 32px;
    }
    .view-pane { display: none; }
    .view-pane.active { display: block; }

    .day-strip {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding: 4px 2px 10px;
      margin-bottom: 8px;
    }
    .day-chip {
      flex: 0 0 auto;
      border: 1.5px solid var(--border);
      background: var(--bg-card);
      color: var(--ink-2);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 6px 13px;
      border-radius: 999px;
      cursor: pointer;
      line-height: 1.45;
    }
    .day-chip.active {
      background: var(--brand);
      color: #FFFFFF;
      border-color: var(--brand);
    }
    .day-chip.done {
      background: var(--emerald-soft);
      color: var(--emerald);
      border-color: #6EE7B7;
    }

    .hero-banner {
      background: linear-gradient(135deg, #0F172A 0%, #134E4A 100%);
      color: #F8FAFC;
      border-radius: var(--radius-lg);
      padding: 16px 18px;
      margin-bottom: 12px;
      box-shadow: var(--shadow);
    }
    .hero-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .hero-pill {
      display: inline-block;
      background: rgba(20, 184, 166, 0.22);
      border: 1px solid rgba(94, 234, 212, 0.4);
      color: #99F6E4;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 999px;
    }
    .off-duty-btn {
      background: rgba(255, 255, 255, 0.14);
      color: #FDE68A;
      border: 1px solid rgba(253, 230, 138, 0.4);
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      cursor: pointer;
    }
    .hero-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.28rem;
      line-height: 1.38;
      margin-bottom: 6px;
      color: #FFFFFF;
    }
    .hero-sub {
      font-size: 0.92rem;
      color: #CBD5E1;
      line-height: 1.54;
      margin-bottom: 12px;
    }
    .big-voice-btn {
      width: 100%;
      background: #14B8A6;
      color: #042F2E;
      border: none;
      font-family: inherit;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      cursor: pointer;
      line-height: 1.45;
      transition: all 0.15s ease;
    }
    .big-voice-btn.playing {
      background: var(--brand-active);
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(216, 82, 46, 0.35);
    }
    .day-prev-next-row {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }
    .day-nav-btn {
      flex: 1;
      background: rgba(255, 255, 255, 0.12);
      color: #F8FAFC;
      border: 1px solid rgba(255, 255, 255, 0.22);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.86rem;
      padding: 7px 12px;
      border-radius: 10px;
      cursor: pointer;
    }
    .day-nav-btn:disabled { opacity: 0.4; cursor: default; }

    .game-nav-card, .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      margin-bottom: 12px;
      box-shadow: var(--shadow);
    }
    .game-nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }
    .game-nav-title {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--ink-2);
    }
    .game-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
      gap: 8px;
    }
    .game-tile {
      border: 1.5px solid var(--border);
      background: var(--bg-subtle);
      color: var(--ink-1);
      padding: 9px 11px;
      border-radius: var(--radius-md);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      text-align: left;
      line-height: 1.42;
      transition: all 0.15s ease;
    }
    .game-tile.active {
      border-color: var(--brand);
      background: #F0FDFA;
      color: var(--brand);
      box-shadow: 0 3px 10px rgba(15, 118, 110, 0.12);
    }
    .game-tile.done {
      border-color: #6EE7B7;
      background: #ECFDF5;
      color: var(--emerald);
    }

    .card-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 10px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--bg-subtle);
    }
    .card-badge {
      display: inline-block;
      background: var(--brand-soft);
      color: var(--brand);
      font-size: 0.8rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .card-inline-controls {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .card-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.24rem;
      line-height: 1.38;
      color: var(--ink-1);
      margin-bottom: 10px;
    }
    .card-story {
      font-size: 0.99rem;
      color: var(--ink-2);
      line-height: 1.68;
      margin-bottom: 12px;
    }
    .reframe-box {
      background: var(--amber-soft);
      border-left: 4px solid #F59E0B;
      color: #78350F;
      padding: 10px 13px;
      border-radius: 10px;
      font-size: 0.93rem;
      margin-bottom: 12px;
      line-height: 1.56;
    }
    .prompt-box {
      background: #F8FAFC;
      border: 1.5px solid #CBD5E1;
      border-radius: var(--radius-md);
      padding: 12px 14px;
      margin-bottom: 12px;
    }
    .prompt-box.followup-box {
      background: var(--indigo-soft);
      border-color: #C7D2FE;
    }
    .prompt-box.yt-box {
      background: var(--rose-soft);
      border-color: #FECDD3;
    }
    .prompt-lbl-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 6px;
      flex-wrap: wrap;
    }
    .prompt-lbl {
      font-size: 0.83rem;
      font-weight: 700;
      color: var(--brand);
    }
    .followup-box .prompt-lbl { color: var(--indigo); }
    .yt-box .prompt-lbl { color: var(--rose); }
    .prompt-txt {
      font-size: 0.98rem;
      font-weight: 600;
      color: var(--ink-1);
      line-height: 1.55;
    }

    .ag-btn {
      border: 1.5px solid var(--border);
      background: var(--bg-subtle);
      color: var(--ink-1);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 8px 13px;
      border-radius: 10px;
      cursor: pointer;
      line-height: 1.4;
      transition: all 0.15s ease;
    }
    .ag-btn:disabled { opacity: 0.4; cursor: default; }
    .ag-btn.listen {
      background: #FEF3C7;
      border-color: #F59E0B;
      color: #78350F;
    }
    .ag-btn.listen.playing {
      background: var(--brand-active);
      border-color: var(--brand-active);
      color: #FFFFFF;
    }
    .ag-btn.check.checked {
      background: var(--emerald);
      border-color: var(--emerald);
      color: #FFFFFF;
    }
    .agenda-actions, .game-stepper-row {
      display: flex;
      gap: 8px;
      margin-top: 10px;
      flex-wrap: wrap;
    }
    .agenda-actions .ag-btn, .game-stepper-row .ag-btn { flex: 1; }

    .slide-img-wrap {
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 10px;
      border: 1px solid var(--border);
    }
    .slide-img { width: 100%; display: block; }
    .slide-dots {
      display: flex;
      gap: 6px;
      justify-content: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .slide-dot {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      border: 1.5px solid var(--border);
      background: var(--bg-subtle);
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
    }
    .slide-dot.active {
      background: var(--brand);
      color: #FFFFFF;
      border-color: var(--brand);
    }
    .pillar-grid {
      display: grid;
      gap: 10px;
      margin-top: 10px;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.66);
      z-index: 300;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 14px;
    }
    .modal-backdrop.open { display: flex; }
    .modal-card {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      max-width: 560px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      padding: 18px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }
    .timer-pill {
      display: inline-block;
      font-weight: 800;
      font-size: 1.15rem;
      color: #B45309;
      margin-top: 6px;
    }
    .toast {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      background: #0F172A;
      color: #F8FAFC;
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 600;
      z-index: 250;
      display: none;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.28);
    }
  </style>
</head>
<body>

  <header class="top-bar">
    <div class="top-bar-inner">
      <div class="brand-wrap" onclick="switchTab('play')">
        <span>⚡ ANANDO</span>
      </div>
      <nav class="nav-tabs">
        <button id="tabPlay" class="tab-btn active" onclick="switchTab('play')">🎯 Today's Flow</button>
        <button id="tabLetter" class="tab-btn" onclick="switchTab('letter')">💌 Letter</button>
        <button id="tabPillars" class="tab-btn" onclick="switchTab('pillars')">🧭 7 Keys</button>
      </nav>
      <div style="display:flex;align-items:center;gap:5px;">
        <button id="topPlayBtn" class="hctrl-btn" data-default-label="🔊 Listen" onclick="toggleMasterAudio()">🔊 Listen</button>
        <button class="sos-btn" onclick="openSosModal()">🚨 Calm Switch</button>
      </div>
    </div>
    <div id="nowPlayingBar" class="now-playing-bar" aria-live="polite">
      <span class="eq-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span id="npTitle" class="np-title">Playing...</span>
      <div id="npTrack" class="np-track" onclick="seekAudioFromTrack(event)">
        <div id="npFill" class="np-fill"></div>
      </div>
      <span id="npTime" class="np-time">0:00</span>
    </div>
  </header>

  <main class="container">
    <!-- TAB 1: 21-DAY HIGH-IQ COMPANION -->
    <section id="viewPlay" class="view-pane active">
      <div id="dayStrip" class="day-strip"></div>

      <div class="hero-banner">
        <div class="hero-top-row">
          <span class="hero-pill" id="heroPhasePill">✨ As the day, so is the day • Zero-Rule Living</span>
          <button class="off-duty-btn" onclick="toggleOffDutyMode()" id="offDutyBtn">🌿 Off-Duty Caretaker</button>
        </div>
        <div class="hero-title" id="heroDayTitle"></div>
        <div class="hero-sub" id="heroDaySub"></div>
        <button id="btnDayMainPlay" class="big-voice-btn" data-default-label="🔊 Listen to Today's Overview" onclick="toggleDayVoice()">
          🔊 Listen to Today's Overview
        </button>
        <div class="day-prev-next-row">
          <button id="prevDayBtn" class="day-nav-btn" onclick="selectDay(curDay - 1, true)">⬅️ Previous Day</button>
          <button id="nextDayBtn" class="day-nav-btn" onclick="selectDay(curDay + 1, true)">Next Day ➡️</button>
        </div>
      </div>

      <div class="game-nav-card">
        <div class="game-nav-header">
          <span class="game-nav-title">🎯 Today's 5 Explorations (Tap any tile):</span>
        </div>
        <div id="gameGrid" class="game-grid"></div>
      </div>

      <div id="activeGameStage"></div>
    </section>

    <!-- TAB 2: 8-SLIDE LETTER TO SELF -->
    <section id="viewLetter" class="view-pane">
      <div class="card" style="background:linear-gradient(135deg,#FFFBEB,#FEF3C7);border-color:#FCD34D;">
        <div style="font-size:0.84rem;font-weight:700;color:#92400E;margin-bottom:6px;">☀️ Daily Anchor</div>
        <div id="quoteBox" style="font-size:1.02rem;font-weight:600;color:#78350F;margin-bottom:10px;"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button id="btnQuotePlay" class="ag-btn listen" data-default-label="🔊 Listen" onclick="toggleQuoteAudio()">🔊 Listen</button>
          <button class="ag-btn" onclick="nextQuote(true)">🎲 Next Anchor</button>
        </div>
      </div>

      <div id="letterStage" class="card"></div>
    </section>

    <!-- TAB 3: 7 CORE DIAGNOSTIC KEYS -->
    <section id="viewPillars" class="view-pane">
      <div class="card">
        <span class="card-badge">🧭 Wiki-Grounded Diagnostic</span>
        <h2 class="card-title" style="margin-top:8px;">Your 7 Core Keys (Zero Guilt, Pure Leverage)</h2>
        <p class="card-story">
          Whenever melancholy, RAM crowding, hesitation, or listening lag shows up, pick the exact key that unlocks it:
        </p>
        <div id="pillarsContainer" class="pillar-grid"></div>
      </div>
    </section>
  </main>

  <!-- EMERGENCY 60-SECOND HARDWARE RESET MODAL -->
  <div id="sosModal" class="modal-backdrop">
    <div class="modal-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span class="card-badge" style="background:#FFE4E6;color:#BE123C;margin:0;">🚨 60-Second Hardware Brake</span>
        <button class="tab-btn" onclick="closeSosModal()">✕ Close</button>
      </div>
      <h3 class="card-title" style="margin-bottom:8px;">Koushik, you are 100% safe and your mind is completely sound.</h3>
      <p class="card-story" style="font-size:0.94rem;margin-bottom:12px;">
        When baseline dopamine dips, an ADHD-High-IQ brain sometimes manufactures counterfeit adrenaline and urges to confess 15-year-old regrets. <strong>Cut power to the simulation physically before thinking a single word:</strong>
      </p>

      <div class="prompt-box" style="background:#EFF6FF;border-color:#BFDBFE;">
        <div class="prompt-lbl" style="color:#1D4ED8;">1. ❄️ Cold-Water Dive Reflex (30 Seconds):</div>
        <p style="font-size:0.92rem;color:#1E3A8A;">Cup cold water over your closed eyelids and cheekbones 4 times for 5 seconds each. Triggers the trigeminal-vagal brake and drops heart rate immediately.</p>
      </div>

      <div class="prompt-box" style="background:#FEF3C7;border-color:#FDE68A;">
        <div class="prompt-lbl" style="color:#B45309;">2. 🧱 20-Second Isometric Wall Push:</div>
        <p style="font-size:0.92rem;color:#78350F;">Press both palms hard into a solid wall for 20 seconds, then release with a long sigh—burning excess adrenaline cleanly out of your muscles.</p>
        <div style="text-align:center;">
          <div id="sosTimerDisplay" class="timer-pill">20s</div><br/>
          <button class="ag-btn listen" style="margin-top:6px;" onclick="startSosTimer(20)">⏱️ Start 20s Timer</button>
        </div>
      </div>

      <div class="prompt-box" style="background:#F0FDFA;border-color:#99F6E4;">
        <div class="prompt-lbl">3. 🔒 Anti-Confession Vault Lock:</div>
        <p style="font-size:0.92rem;color:var(--ink-2);">
          The 33-year-old man is not on trial for the unguided 11-, 17-, 26-, or 30-year-old kid. Bail is 100% paid in full. Zero past excavation while heart rate is elevated.
        </p>
      </div>

      <div class="agenda-actions">
        <a class="ag-btn" href="tel:14416" style="background:#FFF1F2;color:#BE123C;border-color:#FECDD3;text-decoration:none;text-align:center;">📞 Tele-MANAS (14416)</a>
        <button class="ag-btn check checked" onclick="closeSosModal()">🌿 My Body Feels Calmer Now</button>
      </div>
    </div>
  </div>

  <div id="toastEl" class="toast"></div>

  <script>
    const ANANDO_DATA = {{ anando_data_json | safe }};
    const PILLARS_DATA = {{ pillars_data_json | safe }};

    const audioEl = new Audio();
    audioEl.preload = "auto";
    let activeAudioBtnId = null;
    let activeAudioKey = null;
    let activeAudioTitle = "";

    let curTab = "play";
    let curDay = 1;
    let curGame = 0;
    let curSlide = 0;
    let curQuote = 0;
    let curPillar = 0;
    let autoAdvanceSlides = true;
    let autoWelcomeSucceeded = false;
    let autoWelcomeFallbackArmed = false;
    let sosInterval = null;

    const STORAGE_KEY = "anando_koushik_en_done_v2";
    let doneMap = {};
    try {
      doneMap = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    } catch (e) { doneMap = {}; }

    function formatAudioSeconds(sec) {
      if (!sec || !isFinite(sec) || sec < 0) return "0:00";
      const s = Math.floor(sec);
      const mins = Math.floor(s / 60);
      const rem = s % 60;
      return mins + ":" + (rem < 10 ? "0" + rem : rem);
    }

    function updateNowPlayingBar(showBar) {
      const bar = document.getElementById("nowPlayingBar");
      if (!bar) return;
      if (!showBar) {
        bar.classList.remove("visible");
        return;
      }
      bar.classList.add("visible");
      const titleEl = document.getElementById("npTitle");
      const fillEl = document.getElementById("npFill");
      const timeEl = document.getElementById("npTime");
      if (titleEl) titleEl.textContent = activeAudioTitle || "Playing...";
      const dur = audioEl.duration || 0;
      const cur = audioEl.currentTime || 0;
      if (fillEl) {
        const pct = dur > 0 ? Math.min(100, Math.max(0, (cur / dur) * 100)) : 0;
        fillEl.style.width = pct.toFixed(1) + "%";
      }
      if (timeEl) {
        timeEl.textContent = dur > 0
          ? (formatAudioSeconds(cur) + " / " + formatAudioSeconds(dur))
          : formatAudioSeconds(cur);
      }
    }

    function seekAudioFromTrack(ev) {
      const track = document.getElementById("npTrack");
      if (!track || !audioEl.duration || !isFinite(audioEl.duration)) return;
      const rect = track.getBoundingClientRect();
      if (!rect.width) return;
      const ratio = Math.min(1, Math.max(0, (ev.clientX - rect.left) / rect.width));
      audioEl.currentTime = ratio * audioEl.duration;
      updateNowPlayingBar(true);
    }

    function syncAllAudioButtonsUI(isPlaying) {
      document.querySelectorAll("[data-default-label]").forEach(btn => {
        const matchesActive = (btn.id === activeAudioBtnId) ||
          (btn.getAttribute("data-audio-key") && btn.getAttribute("data-audio-key") === activeAudioKey);
        if (matchesActive && isPlaying) {
          btn.classList.add("playing");
          btn.innerHTML = "⏸️ Pause";
        } else {
          btn.classList.remove("playing");
          btn.innerHTML = btn.getAttribute("data-default-label");
        }
      });
      const topBtn = document.getElementById("topPlayBtn");
      if (topBtn) {
        if (isPlaying) {
          topBtn.classList.add("playing");
          topBtn.innerHTML = "⏸️ Pause";
        } else {
          topBtn.classList.remove("playing");
          topBtn.innerHTML = "🔊 Listen";
        }
      }
      updateNowPlayingBar(isPlaying);
    }

    function stopAllAudio() {
      audioEl.pause();
      activeAudioBtnId = null;
      activeAudioKey = null;
      syncAllAudioButtonsUI(false);
    }

    function playOrToggleAudio(btnId, audioKey, srcUrl, titleText, onBlockedCallback) {
      if (!srcUrl) return;
      if (activeAudioKey === audioKey && !audioEl.paused) {
        audioEl.pause();
        syncAllAudioButtonsUI(false);
        return;
      }
      if (activeAudioKey === audioKey && audioEl.paused && audioEl.currentTime > 0 && !audioEl.ended) {
        activeAudioBtnId = btnId;
        syncAllAudioButtonsUI(true);
        audioEl.play().catch(() => syncAllAudioButtonsUI(false));
        return;
      }
      audioEl.pause();
      activeAudioBtnId = btnId;
      activeAudioKey = audioKey;
      activeAudioTitle = titleText || "";
      audioEl.src = srcUrl;
      audioEl.currentTime = 0;
      syncAllAudioButtonsUI(true);
      const p = audioEl.play();
      if (p && p.then) {
        p.then(() => {
          autoWelcomeSucceeded = true;
          detachAutoWelcomeGestureFallback();
        }).catch(() => {
          stopAllAudio();
          if (typeof onBlockedCallback === "function") onBlockedCallback();
        });
      }
    }

    function onFirstGestureWelcomeUnlock(ev) {
      detachAutoWelcomeGestureFallback();
      if (autoWelcomeSucceeded || !audioEl.paused || activeAudioKey) return;
      const explicitTarget = (ev && ev.target && typeof ev.target.closest === "function")
        ? ev.target.closest("#topPlayBtn, #btnDayMainPlay, .ag-btn, .game-tile, .day-chip, .day-nav-btn, .tab-btn, .slide-dot, .big-voice-btn")
        : null;
      if (explicitTarget) return;
      autoWelcomeSucceeded = true;
      if (curTab === "letter") toggleSlideAudio();
      else if (curTab === "pillars") togglePillarVoice(curPillar);
      else toggleDayVoice();
    }

    function attachAutoWelcomeGestureFallback() {
      if (autoWelcomeFallbackArmed || !document.addEventListener) return;
      autoWelcomeFallbackArmed = true;
      document.addEventListener("pointerdown", onFirstGestureWelcomeUnlock, true);
      document.addEventListener("touchstart", onFirstGestureWelcomeUnlock, true);
      document.addEventListener("keydown", onFirstGestureWelcomeUnlock, true);
    }

    function detachAutoWelcomeGestureFallback() {
      if (!autoWelcomeFallbackArmed || !document.removeEventListener) return;
      autoWelcomeFallbackArmed = false;
      document.removeEventListener("pointerdown", onFirstGestureWelcomeUnlock, true);
      document.removeEventListener("touchstart", onFirstGestureWelcomeUnlock, true);
      document.removeEventListener("keydown", onFirstGestureWelcomeUnlock, true);
    }

    function preloadGameAudio(dNum, gIdx) {
      try {
        const dObj = ANANDO_DATA.days[dNum - 1];
        if (!dObj || !dObj.games[gIdx] || typeof Audio !== "function") return;
        const pre = new Audio();
        pre.preload = "auto";
        pre.src = dObj.games[gIdx].audio_url;
      } catch (e) {}
    }

    function engageProactiveWelcomeAudio() {
      const dObj = ANANDO_DATA.days[curDay - 1];
      if (!dObj) return;
      preloadGameAudio(curDay, curGame);
      playOrToggleAudio(
        "btnDayMainPlay",
        "day_main_" + curDay,
        dObj.audio_url,
        "Day " + curDay + ": Overview",
        attachAutoWelcomeGestureFallback
      );
    }

    audioEl.addEventListener("timeupdate", () => {
      if (!audioEl.paused) updateNowPlayingBar(true);
    });

    audioEl.addEventListener("ended", () => {
      const finishedKey = activeAudioKey;
      stopAllAudio();
      if (curTab === "letter" && autoAdvanceSlides && finishedKey && finishedKey.startsWith("slide_") && curSlide < ANANDO_DATA.slides.length - 1) {
        setTimeout(() => goToSlide(curSlide + 1, true), 800);
      } else if (curTab === "play" && finishedKey && finishedKey.startsWith("day_main_")) {
        toggleGameVoice(curDay, curGame);
      } else if (curTab === "pillars" && finishedKey && finishedKey.startsWith("pillar_") && curPillar < PILLARS_DATA.length - 1) {
        curPillar++;
        renderPillarsView();
        setTimeout(() => togglePillarVoice(curPillar), 700);
      }
    });

    function toggleDayVoice() {
      const dObj = ANANDO_DATA.days[curDay - 1];
      if (!dObj) return;
      preloadGameAudio(curDay, curGame);
      playOrToggleAudio("btnDayMainPlay", "day_main_" + curDay, dObj.audio_url, "Day " + curDay + ": Overview", attachAutoWelcomeGestureFallback);
    }

    function toggleGameVoice(dNum, gIdx) {
      const dObj = ANANDO_DATA.days[dNum - 1];
      if (!dObj || !dObj.games[gIdx]) return;
      const g = dObj.games[gIdx];
      const key = "ag_" + dNum + "_" + gIdx;
      playOrToggleAudio("btnAgPlay_" + dNum + "_" + gIdx, key, g.audio_url, g.short, attachAutoWelcomeGestureFallback);
    }

    function toggleQuoteAudio() {
      const q = ANANDO_DATA.quotes[curQuote];
      if (!q) return;
      playOrToggleAudio("btnQuotePlay", "quote_" + curQuote, q.audio_url, "Daily Anchor", attachAutoWelcomeGestureFallback);
    }

    function toggleSlideAudio() {
      const s = ANANDO_DATA.slides[curSlide];
      if (!s) return;
      playOrToggleAudio("btnSlideMainPlay", "slide_" + s.id, s.audio_url, s.badge, attachAutoWelcomeGestureFallback);
    }

    function togglePillarVoice(pIdx) {
      curPillar = Math.max(0, Math.min(PILLARS_DATA.length - 1, pIdx));
      const p = PILLARS_DATA[curPillar];
      const q = ANANDO_DATA.quotes[curPillar % ANANDO_DATA.quotes.length];
      if (!p || !q) return;
      playOrToggleAudio("btnPillarPlay_" + curPillar, "pillar_" + curPillar, p.audio_url || q.audio_url, p.badge, attachAutoWelcomeGestureFallback);
    }

    function toggleMasterAudio() {
      if (!audioEl.paused) {
        audioEl.pause();
        syncAllAudioButtonsUI(false);
        return;
      }
      if (activeAudioKey && audioEl.paused && audioEl.currentTime > 0 && !audioEl.ended) {
        syncAllAudioButtonsUI(true);
        audioEl.play().catch(() => stopAllAudio());
        return;
      }
      if (curTab === "letter") toggleSlideAudio();
      else if (curTab === "pillars") togglePillarVoice(curPillar);
      else if (!autoWelcomeSucceeded && !activeAudioKey) toggleDayVoice();
      else toggleGameVoice(curDay, curGame);
    }

    function showToast(msg) {
      const el = document.getElementById("toastEl");
      el.textContent = msg;
      el.style.display = "block";
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { el.style.display = "none"; }, 3200);
    }

    function switchTab(tab) {
      curTab = tab;
      stopAllAudio();
      ["play", "letter", "pillars"].forEach(t => {
        document.getElementById("view" + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle("active", t === tab);
        document.getElementById("tab" + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle("active", t === tab);
      });
      if (tab === "play") {
        renderPlayView();
        toggleDayVoice();
      } else if (tab === "letter") {
        curQuote = (curQuote + 1) % ANANDO_DATA.quotes.length;
        renderLetterView();
        toggleSlideAudio();
      } else if (tab === "pillars") {
        renderPillarsView();
        togglePillarVoice(curPillar);
      }
    }

    function toggleOffDutyMode() {
      const btn = document.getElementById("offDutyBtn");
      btn.textContent = "✅ Caretaker Shift Off (100% Free)";
      showToast("🌿 Caretaker coat hung up—this evening belongs strictly to play, music & rest!");
    }

    function escapeSingleQuotes(s) {
      return String(s || "").replace(/\\/g, "\\\\").replace(/'/g, "\\'");
    }

    function renderPlayView() {
      const strip = document.getElementById("dayStrip");
      strip.innerHTML = ANANDO_DATA.days.map(d => {
        const allDone = d.games.every((_, idx) => doneMap[d.day + "_" + idx]);
        const cls = "day-chip" + (d.day === curDay ? " active" : "") + (allDone ? " done" : "");
        return `<button class="${cls}" onclick="selectDay(${d.day}, true)">${allDone ? "✅ " : ""}Day ${d.day}</button>`;
      }).join("");

      const dObj = ANANDO_DATA.days[curDay - 1];
      document.getElementById("heroPhasePill").textContent = `✨ ${dObj.phase || 'House-Money Era'} • As the day, so is the day`;
      document.getElementById("heroDayTitle").textContent = `Day ${dObj.day} • ${dObj.title}`;
      document.getElementById("heroDaySub").textContent = dObj.sub;
      document.getElementById("prevDayBtn").disabled = (curDay <= 1);
      document.getElementById("nextDayBtn").disabled = (curDay >= ANANDO_DATA.days.length);

      const grid = document.getElementById("gameGrid");
      grid.innerHTML = dObj.games.map((g, idx) => {
        const isDone = !!doneMap[curDay + "_" + idx];
        const cls = "game-tile" + (idx === curGame ? " active" : "") + (isDone ? " done" : "");
        return `<button class="${cls}" onclick="selectGame(${idx}, true)">${isDone ? "✅ " : ""}${g.short}</button>`;
      }).join("");

      const ag = dObj.games[curGame] || dObj.games[0];
      const isDone = !!doneMap[curDay + "_" + curGame];
      const agAudioKey = `ag_${curDay}_${curGame}`;
      const btnId = `btnAgPlay_${curDay}_${curGame}`;
      const topBtnId = `btnAgPlayTop_${curDay}_${curGame}`;
      const isSong = (ag.pillar === "music") || (ag.category || "").includes("🎵");

      const ytGuideHtml = isSong ? `
        <div class="prompt-box yt-box">
          <div class="prompt-lbl">🎵 Eyes-Closed Pass-1 Listening (@YouTube Music + 3-Pass Bhaavna):</div>
          <div style="font-size:0.92rem;color:var(--ink-2);">Ask Gemini to launch the track on YouTube Music, close your eyes on Pass 1 with zero note-grading, picture the visual movie scene, and then unpack the lyric philosophy in Turn 2.</div>
        </div>` : "";

      const followupHtml = ag.followup_prompt ? `
        <div class="prompt-box followup-box">
          <div class="prompt-lbl-row">
            <span class="prompt-lbl">💬 Turn 2 — Deepen, Steelman or Test Your Ear:</span>
            <button class="ag-btn" style="padding:4px 10px;font-size:0.8rem;" onclick="copyPrompt('${escapeSingleQuotes(ag.followup_prompt)}')">📋 Copy Turn 2</button>
          </div>
          <div class="prompt-txt">“${ag.followup_prompt}”</div>
        </div>` : "";

      document.getElementById("activeGameStage").innerHTML = `
        <article class="card">
          <div class="card-top-bar">
            <span class="card-badge">${ag.category}</span>
            <div class="card-inline-controls">
              <button id="${topBtnId}" class="ag-btn listen" data-default-label="🔊 Listen" data-audio-key="${agAudioKey}" onclick="toggleGameVoice(${curDay}, ${curGame})">🔊 Listen</button>
              <button class="ag-btn check ${isDone ? 'checked' : ''}" onclick="toggleDone(${curDay}, ${curGame})">
                ${isDone ? '✅ Done' : '⬜ Mark Done'}
              </button>
              <button class="ag-btn" ${curGame <= 0 ? "disabled" : ""} onclick="selectGame(${curGame - 1}, true)" title="Previous">⬅️</button>
              <button class="ag-btn" ${curGame >= dObj.games.length - 1 ? "disabled" : ""} onclick="selectGame(${curGame + 1}, true)" title="Next">➡️</button>
            </div>
          </div>

          <h2 class="card-title">${ag.title}</h2>
          <p class="card-story">${ag.detail}</p>
          ${ytGuideHtml}

          <div class="prompt-box">
            <div class="prompt-lbl-row">
              <span class="prompt-lbl">🎙️ Turn 1 — Speak or Paste into Gemini Live:</span>
              <button class="ag-btn" style="padding:4px 10px;font-size:0.8rem;" onclick="copyPrompt('${escapeSingleQuotes(ag.prompt)}')">📋 Copy Turn 1</button>
            </div>
            <div class="prompt-txt">“${ag.prompt}”</div>
          </div>
          ${followupHtml}

          <div class="agenda-actions">
            <button id="${btnId}" class="ag-btn listen" data-default-label="🔊 Listen" data-audio-key="${agAudioKey}" onclick="toggleGameVoice(${curDay}, ${curGame})">🔊 Listen</button>
            <button class="ag-btn check ${isDone ? 'checked' : ''}" onclick="toggleDone(${curDay}, ${curGame})">
              ${isDone ? '✅ Enjoyed & Completed' : '⬜ I Enjoyed This'}
            </button>
          </div>
          <div class="game-stepper-row">
            <button class="ag-btn" ${curGame <= 0 ? "disabled" : ""} onclick="selectGame(${curGame - 1}, true)">⬅️ Previous Exploration</button>
            <button class="ag-btn" ${curGame >= dObj.games.length - 1 ? "disabled" : ""} onclick="selectGame(${curGame + 1}, true)">Next Exploration ➡️</button>
          </div>
        </article>
      `;
      syncAllAudioButtonsUI(!audioEl.paused);
    }

    function getFirstOpenGameForDay(dNum) {
      const dObj = ANANDO_DATA.days[dNum - 1];
      if (!dObj || !dObj.games) return 0;
      for (let i = 0; i < dObj.games.length; i++) {
        if (!doneMap[dNum + "_" + i]) return i;
      }
      return 0;
    }

    function findInitialCurrentDay() {
      for (let i = 0; i < ANANDO_DATA.days.length; i++) {
        const d = ANANDO_DATA.days[i];
        const allDone = d.games.every((_, idx) => doneMap[d.day + "_" + idx]);
        if (!allDone) {
          curDay = d.day;
          curGame = getFirstOpenGameForDay(curDay);
          return;
        }
      }
      curDay = 1;
      curGame = 0;
    }

    function selectDay(d, autoPlay) {
      if (d < 1 || d > ANANDO_DATA.days.length) return;
      curDay = d;
      curGame = getFirstOpenGameForDay(d);
      stopAllAudio();
      renderPlayView();
      if (autoPlay !== false) toggleDayVoice();
    }

    function selectGame(idx, autoPlay) {
      const dObj = ANANDO_DATA.days[curDay - 1];
      curGame = Math.max(0, Math.min(dObj.games.length - 1, idx));
      stopAllAudio();
      renderPlayView();
      if (autoPlay !== false) toggleGameVoice(curDay, curGame);
    }

    function toggleDone(d, idx) {
      const k = d + "_" + idx;
      doneMap[k] = !doneMap[k];
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(doneMap)); } catch (e) {}
      if (doneMap[k]) {
        showToast("⚡ Nice flow, Koushik!");
        const dObj = ANANDO_DATA.days[d - 1];
        if (idx + 1 < dObj.games.length) {
          curGame = idx + 1;
          stopAllAudio();
          renderPlayView();
          toggleGameVoice(d, curGame);
          return;
        } else if (d < ANANDO_DATA.days.length) {
          curDay = d + 1;
          curGame = getFirstOpenGameForDay(curDay);
          stopAllAudio();
          renderPlayView();
          toggleDayVoice();
          return;
        }
      }
      renderPlayView();
    }

    function copyPrompt(txt) {
      if (navigator.clipboard) navigator.clipboard.writeText(txt);
      showToast("📋 Copied—open Gemini Live to speak or paste!");
    }

    function nextQuote(autoPlay) {
      curQuote = (curQuote + 1) % ANANDO_DATA.quotes.length;
      document.getElementById("quoteBox").textContent = "“" + ANANDO_DATA.quotes[curQuote].text + "”";
      stopAllAudio();
      if (autoPlay !== false) toggleQuoteAudio();
    }

    function renderLetterView() {
      document.getElementById("quoteBox").textContent = "“" + ANANDO_DATA.quotes[curQuote].text + "”";
      const s = ANANDO_DATA.slides[curSlide];
      const slideAudioKey = "slide_" + s.id;
      const dotsHtml = ANANDO_DATA.slides.map((item, idx) =>
        `<button class="slide-dot ${idx === curSlide ? 'active' : ''}" onclick="goToSlide(${idx}, true)">${idx + 1}</button>`
      ).join("");
      const imgHtml = s.img_b64 ? `
        <div class="slide-img-wrap">
          <img class="slide-img" src="${s.img_b64}" alt="${s.title}" />
        </div>` : "";

      document.getElementById("letterStage").innerHTML = `
        <div class="card-top-bar">
          <span class="card-badge">${s.badge}</span>
          <div class="card-inline-controls">
            <button id="btnSlideTopPlay" class="ag-btn listen" data-default-label="🔊 Listen to Slide" data-audio-key="${slideAudioKey}" onclick="toggleSlideAudio()">🔊 Listen to Slide</button>
            <button class="ag-btn" ${curSlide <= 0 ? "disabled" : ""} onclick="changeSlide(-1, true)">⬅️ Prev</button>
            <button class="ag-btn" ${curSlide >= ANANDO_DATA.slides.length - 1 ? "disabled" : ""} onclick="changeSlide(1, true)">Next ➡️</button>
          </div>
        </div>
        ${imgHtml}
        <div class="slide-dots">${dotsHtml}</div>
        <h2 class="card-title">${s.title}</h2>
        <div class="reframe-box" style="font-weight:700;">✨ ${s.highlight}</div>
        <p class="card-story">${s.text}</p>
        <button id="btnSlideMainPlay" class="big-voice-btn" data-default-label="🔊 Listen to Slide" data-audio-key="${slideAudioKey}" onclick="toggleSlideAudio()" style="margin-bottom:10px;">
          🔊 Listen to Slide
        </button>
        <div class="game-stepper-row">
          <button class="ag-btn" ${curSlide <= 0 ? "disabled" : ""} onclick="changeSlide(-1, true)">⬅️ Previous</button>
          <button class="ag-btn" onclick="toggleAutoAdvanceSlides()">${autoAdvanceSlides ? "🔁 Auto-Advance: ON" : "🔁 Auto-Advance: OFF"}</button>
          <button class="ag-btn" ${curSlide >= ANANDO_DATA.slides.length - 1 ? "disabled" : ""} onclick="changeSlide(1, true)">Next ➡️</button>
        </div>
      `;
      syncAllAudioButtonsUI(!audioEl.paused);
    }

    function toggleAutoAdvanceSlides() {
      autoAdvanceSlides = !autoAdvanceSlides;
      renderLetterView();
    }

    function goToSlide(idx, autoPlay) {
      curSlide = Math.max(0, Math.min(ANANDO_DATA.slides.length - 1, idx));
      stopAllAudio();
      renderLetterView();
      if (autoPlay !== false) toggleSlideAudio();
    }

    function changeSlide(delta, autoPlay) {
      goToSlide(curSlide + delta, autoPlay !== false);
    }

    function renderPillarsView() {
      document.getElementById("pillarsContainer").innerHTML = PILLARS_DATA.map((p, idx) => `
        <div class="prompt-box" style="margin-bottom:0;">
          <div class="prompt-lbl-row">
            <div class="prompt-lbl">${p.badge} — ${p.title}</div>
            <button id="btnPillarPlay_${idx}" class="ag-btn listen" style="padding:5px 11px;font-size:0.82rem;" data-default-label="🔊 Listen" data-audio-key="pillar_${idx}" onclick="togglePillarVoice(${idx})">🔊 Listen</button>
          </div>
          <p style="font-size:0.94rem;color:var(--ink-2);">${p.detail}</p>
        </div>
      `).join("");
      syncAllAudioButtonsUI(!audioEl.paused);
    }

    function openSosModal() {
      document.getElementById("sosModal").classList.add("open");
    }

    function closeSosModal() {
      document.getElementById("sosModal").classList.remove("open");
      if (sosInterval) clearInterval(sosInterval);
    }

    function startSosTimer(sec) {
      if (sosInterval) clearInterval(sosInterval);
      let rem = sec;
      const el = document.getElementById("sosTimerDisplay");
      el.textContent = rem + "s";
      sosInterval = setInterval(() => {
        rem--;
        if (rem <= 0) {
          clearInterval(sosInterval);
          el.textContent = "✅ 20s complete! Exhale slowly.";
        } else {
          el.textContent = rem + "s";
        }
      }, 1000);
    }

    findInitialCurrentDay();
    renderPlayView();
    renderLetterView();
    renderPillarsView();
    engageProactiveWelcomeAudio();
  </script>
</body>
</html>
