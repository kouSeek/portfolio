<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0F172A" />
  <title>AI Companion — Kalyani (Ma) & Anondo (Koushik) 🪷</title>
  <link id="pageFavicon" data-emoji="🪷" data-png-b64="{{ favicon_uri }}" data-https-png="https://raw.githubusercontent.com/kouSeek/portfolio/ai-companion/assets/icons/favicon-hub.png?v=4" data-https-ico="https://raw.githubusercontent.com/kouSeek/portfolio/ai-companion/assets/icons/favicon-hub.ico?v=4" rel="icon" type="image/png" sizes="64x64" href="https://raw.githubusercontent.com/kouSeek/portfolio/ai-companion/assets/icons/favicon-hub.png?v=4" />
  <link rel="shortcut icon" type="image/x-icon" href="https://raw.githubusercontent.com/kouSeek/portfolio/ai-companion/assets/icons/favicon-hub.ico?v=4" />
  <link rel="apple-touch-icon" sizes="64x64" href="{{ favicon_uri }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Playfair+Display:wght@700&family=Noto+Sans+Bengali:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #F8FAFC;
      --ink: #0F172A;
      --muted: #475569;
      --border: #E2E8F0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', 'Noto Sans Bengali', sans-serif;
      background: radial-gradient(circle at top, #F1F5F9 0%, #F8FAFC 65%);
      color: var(--ink);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }
    .hub {
      max-width: 760px;
      width: 100%;
    }
    .hub-header {
      text-align: center;
      margin-bottom: 24px;
    }
    .hub-pill {
      display: inline-block;
      background: #E0F2FE;
      color: #0369A1;
      font-weight: 700;
      font-size: 0.8rem;
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 10px;
    }
    .hub-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 2rem;
      margin-bottom: 8px;
    }
    .hub-sub {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.55;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 18px;
    }
    .persona-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-decoration: none;
      color: inherit;
      background: #FFFFFF;
      border: 1.5px solid var(--border);
      border-radius: 20px;
      padding: 22px;
      box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
      transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
    }
    .persona-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.1);
    }
    .persona-card.jhalak {
      background: linear-gradient(180deg, #FFFDF7 0%, #FFF7E6 100%);
      border-color: #F59E0B;
    }
    .persona-card.kalyani {
      background: linear-gradient(180deg, #FBF7F0 0%, #FFFFFF 100%);
      border-color: #E7D8C3;
    }
    .persona-card.anondo {
      background: linear-gradient(180deg, #F0FDFA 0%, #FFFFFF 100%);
      border-color: #99F6E4;
    }
    .p-badge {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 4px 11px;
      border-radius: 999px;
      margin-bottom: 12px;
    }
    .jhalak .p-badge { background: #FEF3C7; color: #B45309; }
    .kalyani .p-badge { background: #FFF1EC; color: #D8522E; }
    .anondo .p-badge { background: #CCFBF1; color: #0F766E; }
    .p-title {
      font-size: 1.38rem;
      font-weight: 800;
      margin-bottom: 8px;
      line-height: 1.4;
    }
    .p-desc {
      font-size: 0.94rem;
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 18px;
    }
    .p-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 11px 16px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
    }
    .jhalak .p-cta { background: #D97706; color: #FFFFFF; }
    .kalyani .p-cta { background: #0E8358; color: #FFFFFF; }
    .anondo .p-cta { background: #0F766E; color: #FFFFFF; }
  </style>
</head>
<body>
  <main class="hub">
    <header class="hub-header">
      <div class="hub-pill">🪷 Modular AI Companion Hub</div>
      <h1 class="hub-title">🪷 AI Companion</h1>
      <p class="hub-sub">Select a companion space—crafted with Dopamine-Hitching Reels, Gemini Live prompts, song curiosity, and gentle Ericksonian clarity.</p>
    </header>
    <div class="grid">
      <a class="persona-card jhalak" href="jhalak.html">
        <div>
          <span class="p-badge">Ma • NEW Dopamine-Hitching Reels (Bengali)</span>
          <h2 class="p-title">✨ ঝলক</h2>
          <p class="p-desc">Zero-task, full-screen vertical Reels (`134` cards): pairs Gopal Bhar / Bala Gopala / Maa Sarada comedy & stories with hitched 1-line Covert CBT, 1-tap Curiosity Flip Cards, relevant YouTube links, and `Aoede` Bengali voice.</p>
        </div>
        <span class="p-cta">✨ Open Jhalak (Ma) →</span>
      </a>
      <a class="persona-card kalyani" href="kalyani.html">
        <div>
          <span class="p-badge">Ma • kalyani (Bengali)</span>
          <h2 class="p-title">🌸 কল্যাণী — আজকের খেলা ও চিঠি</h2>
          <p class="p-desc">21-day warm Bengali companion (`126` games): 60% English / 30% Hindi / 10% Bengali confidence, in-card walkie-talkie voice replies, YouTube Music lyrics, and gentle 1-in-2-days Covert CBT.</p>
        </div>
        <span class="p-cta">🌸 Open Kalyani (Ma) →</span>
      </a>
      <a class="persona-card anondo" href="anondo.html">
        <div>
          <span class="p-badge">Me • anondo (English)</span>
          <h2 class="p-title">🌻 ANONDO — Clarity, Listening & Zorba</h2>
          <p class="p-desc">21-day high-IQ English companion (`105` explorations): Wiki-grounded Covert CBT, Pass-1 Active Listening & Comprehension lab, multilingual song bhaavna, frontier science, and Zorba play.</p>
        </div>
        <span class="p-cta">🌻 Open Anondo (Koushik) →</span>
      </a>
    </div>
  </main>
  <script>
    (function hydratePageFavicon() {
      function apply() {
        try {
          if (!document.head || typeof document.createElement !== "function") return;
          const el = document.getElementById("pageFavicon");
          if (!el || !el.getAttribute) return;
          const emoji = el.getAttribute("data-emoji") || "";
          const b64 = el.getAttribute("data-png-b64") || "";
          const httpsPng = el.getAttribute("data-https-png") || b64;
          const httpsIco = el.getAttribute("data-https-ico") || httpsPng;
          const useHttps = (typeof location !== "undefined" && /^https?:$/i.test(location.protocol) && (typeof navigator === "undefined" || navigator.onLine !== false));
          const pngHref = useHttps ? httpsPng : (b64 || httpsPng);
          const icoHref = useHttps ? httpsIco : (b64 || httpsIco);
          document.querySelectorAll('link[rel*="icon"]').forEach(n => { if (n.parentNode) n.parentNode.removeChild(n); });
          const l1 = document.createElement("link");
          l1.id = "pageFavicon";
          l1.setAttribute("data-emoji", emoji);
          l1.setAttribute("data-png-b64", b64);
          l1.setAttribute("data-https-png", httpsPng);
          l1.setAttribute("data-https-ico", httpsIco);
          l1.rel = "icon"; l1.type = "image/png"; l1.sizes = "64x64"; l1.href = pngHref;
          document.head.appendChild(l1);
          const l2 = document.createElement("link");
          l2.rel = "shortcut icon"; l2.type = useHttps ? "image/x-icon" : "image/png"; l2.href = icoHref;
          document.head.appendChild(l2);
          const l3 = document.createElement("link");
          l3.rel = "apple-touch-icon"; l3.sizes = "64x64"; l3.href = b64 || pngHref;
          document.head.appendChild(l3);
        } catch (e) {}
      }
      apply();
      if (typeof setTimeout === "function") setTimeout(apply, 90);
    })();
  </script>
</body>
</html>
